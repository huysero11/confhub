  usecase "UC25. Tổng hợp nhu cầu dịch vụ tự động" as UC25
  usecase "UC26. Gửi đơn đặt hàng, theo dõi trạng thái" as UC26
  usecase "UC51. Theo dõi chi phí dịch vụ" as UC51 <<P5>>
}
rectangle "Vận hành tại chỗ" {
  usecase "UC32. Theo dõi check-in và sức chứa phòng" as UC32
}
rectangle "Hỏi đáp, AI, đánh giá" {
  usecase "UC37. Kiểm duyệt hỏi đáp" as UC37
  usecase "UC40. Xem báo cáo tổng kết tự động" as UC40
}
rectangle "Thông báo và thống kê" {
