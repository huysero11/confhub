@startuml uc-ban-to-chuc
' Phân rã UC theo tác nhân: Ban tổ chức (20 UC)
!include _style.iuml
left to right direction

actor "Ban tổ chức" as BanToChuc
actor "Người dùng" as NguoiDung
BanToChuc -up-|> NguoiDung

rectangle "Hội nghị và chương trình" {
  usecase "UC03. Tạo và cấu hình hội nghị" as UC03
  usecase "UC04. Quản lý phòng" as UC04
  usecase "UC05. Mời và quản lý diễn giả" as UC05
  usecase "UC08. Quản lý phiên" as UC08
}
rectangle "Đăng ký tham dự" {
  usecase "UC09. Quản lý loại vé" as UC09
  usecase "UC14. Duyệt đăng ký tham dự" as UC14
}
rectangle "Xếp lịch" {
  usecase "UC15. Chạy xếp lịch tự động" as UC15
  usecase "UC16. Xem và chỉnh sửa lịch đề xuất" as UC16
  usecase "UC17. Công bố chương trình" as UC17
  usecase "UC19. Xếp lịch lại khi có biến động" as UC19
}
rectangle "Dịch vụ đi kèm" {
