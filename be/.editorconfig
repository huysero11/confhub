root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,csproj,props,slnx,yml,yaml}]
indent_size = 2

[*.cs]
# Phong cách C# (IDE*), kiểm khi build nhờ EnforceCodeStyleInBuild
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Hằng số (const): PascalCase, vd ConnectionString. Đặt trước luật _camelCase để được ưu tiên.
dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Trường private: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_diagnostic.IDE1006.severity = warning

# StyleCop: tắt các luật không hợp quy ước repo
# SA1101 this. | SA1309 _field | SA1200 using ngoài namespace | SA1633 header bản quyền
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1633.severity = none
# SA1600-1602, SA1623, SA1629: không bắt XML doc mọi thành phần
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1629.severity = none
# SA1413 dấu phẩy cuối | SA1000/SA1009/SA1010 cú pháp new() và [..] | SA1313 tham số record PascalCase | SA1516 top-level Program.cs
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1010.severity = none
dotnet_diagnostic.SA1313.severity = none
dotnet_diagnostic.SA1516.severity = none

# RCS1194: không bắt đủ 3 constructor chuẩn cho exception — exception nghiệp vụ của repo
# luôn cần tham số riêng (vd Code), constructor rỗng sẽ cho phép ném lỗi thiếu mã.
dotnet_diagnostic.RCS1194.severity = none

# CA1848: không bắt dùng [LoggerMessage] (source generator) thay cho logger.LogXxx —
# chỉ tối ưu hiệu năng rất nhỏ, đổi lại code khó đọc. Ưu tiên code đơn giản.
dotnet_diagnostic.CA1848.severity = none

# Roslynator: ASP.NET Core không cần ConfigureAwait(false)
roslynator_configure_await = false
dotnet_diagnostic.RCS1090.severity = none

# Migration do EF Core tự sinh (dotnet ef migrations add): đánh dấu là code tự sinh
# để analyzer không bắt lỗi style. Không sửa tay các file này.
[**/Migrations/**.cs]
generated_code = true
